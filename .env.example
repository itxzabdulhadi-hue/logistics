# PostgreSQL connection string. Prefer your provider's pooled/TLS URL for Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate locally with: openssl rand -base64 32
AUTH_SECRET=dev-only

# Optional: debug, info, warn, or error
LOG_LEVEL=info

# Optional. Serverless-safe default is 1 connection per warm function instance.
# PG_POOL_MAX=1

# Required to enable hosted Stripe Checkout and signed webhook processing.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_URL=https://your-production-domain.example

# Required for cross-instance Vercel WebSocket live tracking (Upstash Redis TLS URL).
# REDIS_URL=rediss://default:TOKEN@HOST:PORT
